# The dev shell through breakbulk's own direnvrc (lib/direnvrc.nix):
# nix-direnv keeps the shell as a GC root, so the git hooks' pre-commit and
# the toolchain survive garbage collection, and the shell reloads when a
# Cargo manifest, lockfile or Nix file changes.
source "$(nix build .#direnvrc --print-out-paths --out-link .direnv/breakbulk-direnvrc)"
use breakbulk
