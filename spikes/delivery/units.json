{
  "comment": "Stand-in for breakbulk-instantiate's templated output. Argument and env values are segment lists: a string is literal; {unit, output, file?} is an upstream unit output; {tool} a toolchain derivation output; {src} a source view.",
  "units": {
    "a": {
      "name": "a-0.1.0-lib",
      "outputs": ["rmeta", "rlib"],
      "env": {
        "BREAKBULK_UNIT": ["{\"crate\":\"a\",\"rustc\":\"", {"tool": "toolchain"}, "/bin/rustc\",\"src\":\"", {"src": "a"}, "/src/lib.rs\"}"]
      }
    },
    "b": {
      "name": "b-0.1.0-lib",
      "outputs": ["rmeta", "rlib"],
      "env": {
        "BREAKBULK_UNIT": ["{\"crate\":\"b\",\"extern\":[\"", {"unit": "a", "output": "rmeta", "file": "/liba.rmeta"}, "\"],\"rustc\":\"", {"tool": "toolchain"}, "/bin/rustc\"}"]
      }
    },
    "c": {
      "name": "c-0.1.0-lib",
      "outputs": ["rmeta", "rlib"],
      "env": {
        "BREAKBULK_UNIT": ["{\"crate\":\"c\",\"extern\":[\"", {"unit": "a", "output": "rmeta", "file": "/liba.rmeta"}, "\"],\"rustc\":\"", {"tool": "toolchain"}, "/bin/rustc\"}"]
      }
    },
    "d": {
      "name": "app-0.1.0-bin",
      "outputs": ["out"],
      "env": {
        "BREAKBULK_UNIT": ["{\"crate\":\"app\",\"extern\":[\"", {"unit": "b", "output": "rlib", "file": "/libb.rlib"}, "\",\"", {"unit": "c", "output": "rlib", "file": "/libc.rlib"}, "\",\"", {"unit": "a", "output": "rlib", "file": "/liba.rlib"}, "\"],\"rustc\":\"", {"tool": "toolchain"}, "/bin/rustc\"}"]
      }
    },
    "e": {
      "name": "tool-0.1.0-bin",
      "outputs": ["out"],
      "env": {
        "BREAKBULK_UNIT": ["{\"crate\":\"tool\",\"extern\":[\"", {"unit": "a", "output": "rlib", "file": "/liba.rlib"}, "\"],\"rustc\":\"", {"tool": "toolchain"}, "/bin/rustc\"}"]
      }
    }
  },
  "order": ["a", "b", "c", "d", "e"],
